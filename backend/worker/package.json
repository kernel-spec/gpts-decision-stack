{
  "name": "gpts-decision-stack-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers backend for the gpts-decision-stack actions interface",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env prod",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@cloudflare/workers-types": "^4.20260313.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.78.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.9.1",
    "@emnapi/runtime": "1.9.1"
  }
}
